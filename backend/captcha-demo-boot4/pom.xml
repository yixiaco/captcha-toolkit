<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yixiaco</groupId>
        <artifactId>captcha-toolkit-parent</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>captcha-demo-boot4</artifactId>
    <name>captcha-demo-boot4</name>
    <description>Spring Boot 4 演示应用：集成 captcha-spring-boot4-starter 后即可直接运行</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yixiaco</groupId>
            <artifactId>captcha-spring-boot4-starter</artifactId>
        </dependency>
        <!-- Starter 中 Web 是 optional，演示应用需要显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              demo 只是演示应用，不发布到 Maven Central；
              发布时用 -pl captcha-core,captcha-spring-boot4-starter -am 选模块，
              这里再兜一层，避免将来整仓 -Prelease deploy 时误发。
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
