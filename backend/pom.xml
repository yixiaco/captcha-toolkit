<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：统一 Spring Boot 版本、Java 版本与模块依赖 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.captcha.toolkit</groupId>
    <artifactId>captcha-toolkit-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>captcha-toolkit-parent</name>
    <description>可嵌入的极验风格行为验证码工具：核心引擎 + Spring Boot Starter + 演示应用</description>

    <modules>
        <module>captcha-core</module>
        <module>captcha-spring-boot-starter</module>
        <module>captcha-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- 与 puzzle_captcha 参考实现一致：柔光投影 / alpha 反转滤镜 -->
        <jhlabs.version>2.0.235-1</jhlabs.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.captcha.toolkit</groupId>
                <artifactId>captcha-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.captcha.toolkit</groupId>
                <artifactId>captcha-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
