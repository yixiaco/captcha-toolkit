<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yixiaco</groupId>
        <artifactId>captcha-toolkit-parent</artifactId>
        <version>0.4.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>captcha-spring-boot4-starter</artifactId>
    <name>captcha-spring-boot4-starter</name>
    <description>Spring Boot 4 自动配置：一行依赖即可把验证码接口嵌入任意 Web 项目</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yixiaco</groupId>
            <artifactId>captcha-core</artifactId>
        </dependency>
        <!-- 传递核心启动器：自动配置、ConfigurationProperties 绑定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Bean Validation：@Validated + @NotNull/@NotBlank 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Web 支持设为 optional：宿主项目已有 Web 时由宿主提供，纯后端项目也不会被强制引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          自动配置集成测试：覆盖 Boot 4 / Jackson 3 下的 HTTP 绑定与位移校验链路。
          排除 Mockito：JDK 24+ 默认禁止动态挂载 agent，而 Boot 的 Mockito 支持会自附加 agent，
          该测试只需要 JUnit 与断言。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
