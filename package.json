{
  "name": "captcha-toolkit-workspace",
  "private": true,
  "description": "行为验证码工具包 monorepo：packages/ 下是两个可发布的 Vue 组件库（Vue 3 / Vue 2.7）",
  "repository": {
    "type": "git",
    "url": "https://github.com/yixiaco/captcha-toolkit.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:lib": "npm run build:lib --workspaces --if-present",
    "build:demo": "npm run build:demo --workspace captcha-toolkit-vue",
    "smoke": "npm run smoke --workspace captcha-toolkit-vue2",
    "dev": "npm run dev --workspace captcha-toolkit-vue",
    "dev:vue2": "npm run dev --workspace captcha-toolkit-vue2"
  }
}
