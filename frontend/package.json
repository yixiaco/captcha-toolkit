{
  "name": "captcha-toolkit-vue",
  "version": "0.1.0",
  "description": "Vue 3 行为验证码组件库：滑块拼图 / 文字点选 / 图形点选 / 旋转 / 角度 / 刮刮乐 / 曲线等，配合 captcha-spring-boot4-starter / captcha-spring-boot3-starter 后端使用",
  "type": "module",
  "license": "MIT",
  "author": "yixiaco",
  "homepage": "https://yixiaco.github.io/captcha-toolkit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yixiaco/captcha-toolkit.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/yixiaco/captcha-toolkit/issues"
  },
  "keywords": [
    "captcha",
    "vue",
    "vue3",
    "behavior-captcha",
    "slider-captcha",
    "puzzle-captcha",
    "verification",
    "验证码"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/captcha-toolkit.umd.cjs",
  "module": "./dist/captcha-toolkit.js",
  "types": "./dist/captcha-toolkit.d.ts",
  "style": "./dist/captcha-toolkit.css",
  "exports": {
    ".": {
      "types": "./dist/captcha-toolkit.d.ts",
      "import": "./dist/captcha-toolkit.js",
      "require": "./dist/captcha-toolkit.umd.cjs"
    },
    "./style.css": "./dist/captcha-toolkit.css"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "build:lib": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.3",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.6"
  }
}
